#!/usr/bin/env python3
"""Contact sheet — a fullscreen grid of the clips under the plates directory.

Every tile is a live stream, muted and looping, so the sheet reads as one moving
surface rather than a wall of thumbnails you have to click to understand. Gifs
and video go through the same code path: GTK 4.22 has the GStreamer media
backend built in (GtkGstMediaFileBuiltin), and it decodes gif through
gdkpixbufdec just as happily as it decodes h264 through libav.

Only tiles inside the viewport hold a playing decoder, and no more than
MAX_PLAYING of them at once. With a handful of clips that ceiling never binds,
but it is what keeps the sheet usable when the directory grows.

Tiles are drawn with Gtk.Picture over the stream's paintable rather than
Gtk.Video, because Gtk.Video insists on its own control overlay. The solo view
does use Gtk.Video — there a scrubber is worth having.
"""

import argparse
import json
import os
import sys
from pathlib import Path

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
from gi.repository import Gdk, GLib, Gtk  # noqa: E402

HOME = Path.home()
PLATES = HOME / ".local/share/rice/art/.plates"
COLORS = HOME / ".local/share/rice/colors.json"

EXTS = {".gif", ".mp4", ".webm", ".mkv", ".mov", ".avi", ".m4v", ".webp", ".apng"}

# Tiles are a fixed box and the frame is fitted inside it, never cropped. The
# clips run from 234x375 portrait to 1280x720 landscape; cropping to a common
# aspect would throw away the subject of half of them.
TILE_W, TILE_H = 300, 260
MAX_PLAYING = 12
# Start decoding a little before a tile scrolls in, so it is already moving by
# the time it is actually on screen.
PRELOAD_PX = 400

FALLBACK = {
    "surface": "#131313",
    "surface_low": "#1b1b1b",
    "surface_container": "#1f1f1f",
    "on_surface": "#e2e2e2",
    "outline": "#919191",
    "outline_variant": "#474747",
}


def read_colors():
    try:
        with open(COLORS, encoding="utf-8") as fh:
            return {**FALLBACK, **json.load(fh)}
    except (OSError, ValueError):
        # Mid-write or absent; the fallback greys keep the sheet legible.
        return dict(FALLBACK)


def keep_looping(stream):
    """Restart the stream ourselves when it runs out.

    set_loop(True) is a no-op on the builtin GStreamer backend: instead of
    signalling end-of-stream it simply stalls on the last frame, leaving
    `playing` true and `ended` false, so GTK's own loop handling — which keys
    off end-of-stream — is never reached. The timestamp does come to rest
    exactly on the duration, and that is what we watch for.
    """
    def restart(media, _pspec):
        duration = media.get_duration()
        # Duration reads 0 until the stream is prepared; a later notify will do.
        if duration <= 0 or media.get_timestamp() < duration:
            return
        if media.is_seekable():
            media.seek(0)
            if not media.get_playing():
                media.play()

    stream.connect("notify::timestamp", restart)


def collect(directory):
    if not directory.is_dir():
        return []
    found = [p for p in directory.iterdir()
             if p.is_file() and p.suffix.lower() in EXTS]
    return sorted(found, key=lambda p: p.name.lower())


class Tile(Gtk.Frame):
    """One clip in the sheet. The stream is created lazily and released on idle."""

    def __init__(self, path):
        super().__init__()
        self.path = path
        self.stream = None
        self.add_css_class("tile")

        self.picture = Gtk.Picture()
        self.picture.set_content_fit(Gtk.ContentFit.CONTAIN)
        self.picture.set_size_request(TILE_W, TILE_H)
        self.set_child(self.picture)

    def wake(self):
        if self.stream is None:
            self.stream = Gtk.MediaFile.new_for_filename(str(self.path))
            self.stream.set_muted(True)
            self.stream.set_loop(True)
            keep_looping(self.stream)
            self.picture.set_paintable(self.stream)
        if not self.stream.get_playing():
            self.stream.play()

    def doze(self):
        """Stop decoding but keep the stream, so the last frame stays painted."""
        if self.stream is not None and self.stream.get_playing():
            self.stream.pause()

    def release(self):
        if self.stream is not None:
            self.stream.pause()
            self.picture.set_paintable(None)
            self.stream = None


class Sheet(Gtk.ApplicationWindow):
    def __init__(self, app, paths, panic=False):
        super().__init__(application=app, title="Contact Sheet")
        self.paths = paths
        self.tiles = []
        self.solo_stream = None
        self._pending = None

        self.set_default_size(1280, 800)
        self.fullscreen()

        self.stack = Gtk.Stack()
        self.stack.set_transition_type(Gtk.StackTransitionType.CROSSFADE)
        self.stack.set_transition_duration(120)
        self.set_child(self.stack)

        self._build_grid()
        self._build_solo()

        keys = Gtk.EventControllerKey()
        keys.connect("key-pressed", self._on_key)
        self.add_controller(keys)

        if panic:
            # Anything stealing focus closes the sheet outright.
            self.connect("notify::is-active",
                         lambda *_: self.is_active() or self.close())

        self.connect("close-request", self._on_close)

    # ------------------------------------------------------------------ build

    def _build_grid(self):
        self.flow = Gtk.FlowBox()
        self.flow.set_valign(Gtk.Align.START)
        self.flow.set_selection_mode(Gtk.SelectionMode.NONE)
        self.flow.set_homogeneous(True)
        self.flow.set_max_children_per_line(8)
        self.flow.set_row_spacing(6)
        self.flow.set_column_spacing(6)
        self.flow.set_margin_top(18)
        self.flow.set_margin_bottom(18)
        self.flow.set_margin_start(18)
        self.flow.set_margin_end(18)

        for path in self.paths:
            tile = Gtk.FlowBoxChild()
            widget = Tile(path)
            tile.set_child(widget)

            click = Gtk.GestureClick()
            click.connect("released", self._on_tile_clicked, widget)
            widget.add_controller(click)

            hover = Gtk.EventControllerMotion()
            hover.connect("enter", lambda *_a, w=widget: w.add_css_class("hot"))
            hover.connect("leave", lambda *_a, w=widget: w.remove_css_class("hot"))
            widget.add_controller(hover)

            self.flow.append(tile)
            self.tiles.append(widget)

        self.scroller = Gtk.ScrolledWindow()
        self.scroller.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.scroller.set_child(self.flow)
        self.scroller.get_vadjustment().connect("value-changed", self._queue_sync)
        self.scroller.connect("map", self._queue_sync)
        self.scroller.connect("notify::default-height", self._queue_sync)

        self.stack.add_named(self.scroller, "grid")

    def _build_solo(self):
        # Just an empty holder. A fresh Gtk.Video is built for each clip and
        # thrown away on close, because clearing a persistent one is not safe:
        # both set_media_stream(None) and set_file(None) drop a reference GTK
        # still owns, and the process segfaults at teardown. Letting the widget
        # be destroyed with its stream still attached goes through GTK's normal
        # dispose path instead, which is correct.
        self.solo_holder = Gtk.Box()
        self.solo_holder.set_hexpand(True)
        self.solo_holder.set_vexpand(True)
        self.video = None
        self.stack.add_named(self.solo_holder, "solo")

    # ------------------------------------------------------------- visibility

    def _queue_sync(self, *_args):
        """Coalesce a burst of scroll events into one pass over the tiles."""
        if self._pending is not None:
            return
        self._pending = GLib.idle_add(self._sync, priority=GLib.PRIORITY_LOW)

    def _sync(self):
        self._pending = None
        if self.stack.get_visible_child_name() != "grid":
            return GLib.SOURCE_REMOVE

        height = self.scroller.get_height()
        if height <= 0:
            return GLib.SOURCE_REMOVE

        visible = []
        for tile in self.tiles:
            ok, rect = tile.compute_bounds(self.scroller)
            if not ok:
                continue
            top = rect.origin.y
            bottom = top + rect.size.height
            if bottom > -PRELOAD_PX and top < height + PRELOAD_PX:
                visible.append(tile)
            else:
                tile.release()

        # Nearest the viewport wins when more tiles are in range than the
        # decoder budget allows.
        for index, tile in enumerate(visible):
            if index < MAX_PLAYING:
                tile.wake()
            else:
                tile.doze()
        return GLib.SOURCE_REMOVE

    # ----------------------------------------------------------------- events

    def _on_tile_clicked(self, gesture, n_press, x, y, widget):
        if gesture.get_current_button() != Gdk.BUTTON_PRIMARY:
            return
        self._open_solo(widget.path)

    def _open_solo(self, path):
        for tile in self.tiles:
            tile.doze()

        self.video = Gtk.Video()
        self.video.set_loop(True)
        self.video.set_hexpand(True)
        self.video.set_vexpand(True)
        click = Gtk.GestureClick()
        click.connect("released", lambda *_: self._close_solo())
        self.video.add_controller(click)

        self.solo_stream = Gtk.MediaFile.new_for_filename(str(path))
        self.solo_stream.set_loop(True)
        keep_looping(self.solo_stream)
        self.video.set_media_stream(self.solo_stream)

        self.solo_holder.append(self.video)
        self.solo_stream.play()
        self.stack.set_visible_child_name("solo")

    def _close_solo(self):
        if self.stack.get_visible_child_name() != "solo":
            return
        if self.solo_stream is not None:
            self.solo_stream.pause()
        if self.video is not None:
            self.solo_holder.remove(self.video)
        self.video = None
        self.solo_stream = None
        self.stack.set_visible_child_name("grid")
        self._queue_sync()

    def _on_key(self, _controller, keyval, _keycode, _state):
        if keyval == Gdk.KEY_Escape:
            # One step out of the solo view, otherwise straight out entirely.
            if self.stack.get_visible_child_name() == "solo":
                self._close_solo()
            else:
                self.close()
            return True
        if keyval in (Gdk.KEY_q, Gdk.KEY_Q):
            self.close()
            return True
        return False

    def _on_close(self, *_args):
        for tile in self.tiles:
            tile.release()
        if self.solo_stream is not None:
            self.solo_stream.pause()
            self.solo_stream = None
        return False


def build_css(colors):
    return f"""
    window {{ background-color: {colors['surface']}; }}
    .tile {{
        background-color: {colors['surface_low']};
        border: 1px solid {colors['outline_variant']};
        border-radius: 2px;
        padding: 0;
    }}
    .tile.hot {{ border-color: {colors['on_surface']}; }}
    """.encode("utf-8")


def main():
    parser = argparse.ArgumentParser(add_help=True, description=__doc__)
    parser.add_argument("directory", nargs="?", default=str(PLATES),
                        help="directory to sheet (default: the plates directory)")
    parser.add_argument("--panic", action="store_true",
                        help="close as soon as the window loses focus")
    args = parser.parse_args()

    directory = Path(args.directory).expanduser()
    paths = collect(directory)
    if not paths:
        print(f"nothing to show in {directory}", file=sys.stderr)
        return 1

    app = Gtk.Application(application_id="sh.rice.contact",
                          flags=0)

    def on_activate(application):
        provider = Gtk.CssProvider()
        provider.load_from_data(build_css(read_colors()))
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        Sheet(application, paths, panic=args.panic).present()

    app.connect("activate", on_activate)
    return app.run([])


if __name__ == "__main__":
    sys.exit(main())

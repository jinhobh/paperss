[Unit]
Description=Refresh the root-window collage periodically

[Timer]
# Hourly, so the activity ribbon fills in over the course of the day, plus a
# run shortly after login. Persistent catches up after suspend or a day off.
OnCalendar=hourly
OnStartupSec=3min
Persistent=true
AccuracySec=1min

[Install]
WantedBy=timers.target

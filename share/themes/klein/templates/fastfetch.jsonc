// GENERATED BY `retheme` — do not edit by hand.
// Source palette: {{colors.source_color.default.hex}}
//
// fastfetch takes colors as bare SGR triples ("38;2;R;G;B"), not hex and not
// full escape sequences — a literal ESC byte here is invalid JSON.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "none"
  },
  "display": {
    "separator": " ",
    "color": {
      "keys": "38;2;{{colors.primary.default.red}};{{colors.primary.default.green}};{{colors.primary.default.blue}}",
      "title": "38;2;{{colors.tertiary.default.red}};{{colors.tertiary.default.green}};{{colors.tertiary.default.blue}}"
    }
  },
  "modules": [
    { "type": "custom", "outputColor": "{{colors.outline.default.red}};{{colors.outline.default.green}};{{colors.outline.default.blue}}",
      "format": "┌─ System ─────────────────────────────" },
    { "type": "os", "key": "  OS" },
    { "type": "kernel", "key": "  Kernel" },
    { "type": "wm", "key": "  WM" },
    { "type": "shell", "key": "  Shell" },
    { "type": "terminal", "key": "  Terminal" },
    { "type": "uptime", "key": "  Uptime" },
    { "type": "custom", "outputColor": "{{colors.outline.default.red}};{{colors.outline.default.green}};{{colors.outline.default.blue}}",
      "format": "├─ Hardware ───────────────────────────" },
    { "type": "cpu", "key": "  CPU" },
    { "type": "gpu", "key": "  GPU" },
    { "type": "memory", "key": "  Memory" },
    { "type": "disk", "key": "  Disk" },
    { "type": "display", "key": "  Display" },
    { "type": "custom", "outputColor": "{{colors.outline.default.red}};{{colors.outline.default.green}};{{colors.outline.default.blue}}",
      "format": "└──────────────────────────────────────" },
    "break",
    { "type": "colors", "symbol": "circle" }
  ]
}

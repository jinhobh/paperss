#!/usr/bin/env python3
"""Refresh desktop clients and `swaybg` from the active Paperss palette.

Hyprland, Waybar, Wofi, Mako, Firefox, and Spotify do not all consume
Matugen templates directly, so this bridge renders their lightweight config
fragments and asks live clients to reread them. It is safe outside a Hyprland
session.
"""
import json
import os
import shlex
import shutil
import subprocess
from pathlib import Path

HOME = Path.home()
COLORS = HOME / ".local/share/rice/colors.json"


def write(path: Path, text: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    if not path.exists() or path.read_text() != text:
        path.write_text(text)


def run(args: list[str], *, env: dict[str, str] | None = None) -> None:
    if shutil.which(args[0]):
        subprocess.run(args, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                       check=False, env=env)


def hyprland_env() -> dict[str, str] | None:
    """Return an environment targeting the newest live Hyprland instance.

    Palette refreshes are also launched by timers and automation that do not
    inherit HYPRLAND_INSTANCE_SIGNATURE. Hyprctl only needs that signature and
    the runtime directory, so recover them from Hyprland's control socket.
    """
    env = os.environ.copy()
    runtime = Path(env.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"))
    sockets = list((runtime / "hypr").glob("*/.socket.sock"))
    if not sockets:
        return None
    # Session launchers and long-running automation can retain the signature
    # of a compositor that has since restarted. The newest control socket is
    # the current graphical session and is more reliable than inherited state.
    newest = max(sockets, key=lambda path: path.stat().st_mtime)
    env["XDG_RUNTIME_DIR"] = str(runtime)
    env["HYPRLAND_INSTANCE_SIGNATURE"] = newest.parent.name
    return env


def firefox_chrome_dirs() -> list[Path]:
    """Find Firefox profile chrome directories in native and Snap layouts."""
    roots = (
        HOME / ".mozilla/firefox",
        HOME / "snap/firefox/common/.mozilla/firefox",
    )
    profiles: list[Path] = []
    seen: set[Path] = set()
    for root in roots:
        if not root.is_dir():
            continue
        for profile in root.iterdir():
            if not profile.is_dir() or not (profile / "prefs.js").exists():
                continue
            chrome = profile / "chrome"
            if chrome not in seen:
                seen.add(chrome)
                profiles.append(chrome)
    return profiles


def main() -> None:
    if not COLORS.exists():
        return
    c = json.loads(COLORS.read_text())
    surface = c["surface"]
    low = c["surface_low"]
    high = c["surface_high"]
    text = c["on_surface"]
    muted = c["outline"]
    accent = c["primary"]
    alternate = c.get("green", c["tertiary"])
    danger = c.get("red", c["error"])

    # GTK entry points live under ~/.config, which confined apps such as the
    # Firefox Snap can read. Keep a local copy there instead of importing the
    # palette through ~/.local/share, which the Snap sandbox rejects.
    gtk_palette = HOME / ".local/share/rice/gtk-colors.css"
    if gtk_palette.exists():
        palette_text = gtk_palette.read_text()
        write(HOME / ".config/gtk-3.0/rice-colors.css", palette_text)
        write(HOME / ".config/gtk-4.0/rice-colors.css", palette_text)

    write(HOME / ".config/hypr/rice-colors.conf", f"""# Generated by Paperss — do not edit by hand.
general {{
    col.active_border = rgba({accent[1:]}ff) rgba({alternate[1:]}ff) 45deg
    col.inactive_border = rgba({c['outline_variant'][1:]}cc)
}}

decoration {{
    shadow {{
        color = rgba(00000088)
    }}
}}
""")

    write(HOME / ".config/waybar/style.css", f"""/* Generated by Paperss — do not edit by hand. */
@define-color surface {surface};
@define-color surface_high {high};
@define-color text {text};
@define-color muted {muted};
@define-color accent {accent};
@define-color accent_alt {alternate};
@define-color danger {danger};

* {{ border: none; border-radius: 0; min-height: 0; font-family: "FiraCode Nerd Font Mono"; font-size: 12px; font-weight: 600; }}
window#waybar {{ background: transparent; color: @text; }}
#custom-rice, #clock, #custom-media, #workspaces, .modules-right {{ background: alpha(@surface, 0.90); border: 1px solid alpha(@surface_high, 0.92); border-radius: 14px; margin-top: 5px; }}
#custom-rice {{ color: @accent_alt; padding: 3px 7px 3px 10px; margin-left: 5px; border-right: 0; border-radius: 14px 0 0 14px; }}
#clock {{ padding: 3px 11px 3px 7px; border-left: 0; border-radius: 0 14px 14px 0; }}
#custom-media {{ color: @muted; padding: 3px 12px; margin-left: 6px; }}
#workspaces {{ padding: 3px 4px; }}
#workspaces button {{ color: @muted; padding: 0 8px; margin: 0 1px; border-radius: 10px; transition: all .18s ease; }}
#workspaces button.active {{ color: @surface; background: @accent; padding: 0 15px; }}
#workspaces button.urgent {{ color: @danger; }}
#workspaces button:hover {{ color: @text; background: alpha(@surface_high, .9); }}
.modules-right {{ padding: 3px 5px; margin-right: 5px; }}
#pulseaudio, #network, #bluetooth, #backlight, #battery, #custom-control-center, #tray {{ padding: 0 7px; }}
#pulseaudio.muted, #network.disconnected, #bluetooth.off, #bluetooth.disabled {{ color: @muted; }}
#custom-control-center {{ color: @accent; font-size: 14px; }}
#battery.warning {{ color: @accent_alt; }}
#battery.critical {{ color: @danger; }}
""")

    write(HOME / ".config/wofi/style.css", f"""/* Generated by Paperss — do not edit by hand. */
window {{ margin: 0; border: 1px solid {c['outline_variant']}; border-radius: 14px; background-color: rgba({int(surface[1:3], 16)}, {int(surface[3:5], 16)}, {int(surface[5:7], 16)}, .96); font-family: "FiraCode Nerd Font Mono"; font-size: 13px; }}
#input {{ margin: 12px; padding: 11px 13px; border: 1px solid {c['outline_variant']}; border-radius: 10px; color: {text}; background-color: {low}; }}
#input:focus {{ border-color: {accent}; }}
#inner-box {{ margin: 0 8px 10px; }} #outer-box {{ padding: 0; }} #scroll {{ margin: 0; }}
#text {{ margin: 0 10px; color: {text}; }} #entry {{ padding: 10px 8px; border-radius: 8px; }}
#entry:selected {{ background-color: {high}; }} #entry:selected #text {{ color: {accent}; }} #img {{ margin-right: 8px; }}
""")

    write(HOME / ".config/mako/config", f"""# Generated by Paperss — do not edit by hand.
font=FiraCode Nerd Font Mono 10
background-color={low}f2
text-color={text}
border-color={accent}
progress-color=over {high}
width=360
height=120
outer-margin=14
margin=10
padding=14
border-size=1
border-radius=10
default-timeout=5000
ignore-timeout=0
icons=1
max-icon-size=48
actions=1

[urgency=high]
border-color={danger}
default-timeout=10000
""")

    # Re:fox consumes the conventional pywal cache. Map Paperss' semantic
    # palette into those sixteen slots, then expose the exact semantic colors
    # to Re:fox's userContent templates as CSS variables.
    try:
        rice_state = json.loads((HOME / ".local/share/rice/state.json").read_text())
        wallpaper = rice_state.get("wallpaper") or (
            rice_state.get("source", "") if rice_state.get("kind") == "image" else ""
        )
    except (OSError, json.JSONDecodeError):
        wallpaper = ""
    wal_colors = {
        "color0": surface,
        "color1": danger,
        "color2": alternate,
        "color3": c.get("yellow", c["tertiary"]),
        "color4": accent,
        "color5": c["tertiary"],
        "color6": c["secondary"],
        "color7": text,
        "color8": c["outline_variant"],
        "color9": c["error"],
        "color10": accent,
        "color11": c.get("yellow", c["tertiary"]),
        "color12": c["primary_container"],
        "color13": alternate,
        "color14": c["secondary"],
        "color15": text,
    }
    write(HOME / ".cache/wal/colors.json", json.dumps({
        "wallpaper": wallpaper,
        "alpha": "100",
        "special": {
            "background": surface,
            "foreground": text,
            "cursor": accent,
        },
        "colors": wal_colors,
    }, indent=2) + "\n")

    firefox_css = f"""/* Generated by Paperss for Re:fox — do not edit by hand. */
:root {{
  --refox-background: {surface} !important;
  --refox-background-light: {low} !important;
  --refox-background-extra: {high} !important;
  --refox-accent-primary: {accent} !important;
  --refox-accent-secondary: {alternate} !important;
  --refox-text: {c['on_surface_variant']} !important;
  --refox-text-focus: {text} !important;
  --refox-text-muted: {c.get('text_muted', c['on_surface_variant'])} !important;
  /* userChrome.css applies this to browser chrome only. Keeping the actual
     color-scheme property out of this shared file prevents userContent.css
     from forcing Firefox's UI scheme onto every website. */
  --rice-firefox-color-scheme: {c.get('mode', 'dark')};
}}
"""
    for chrome in firefox_chrome_dirs():
        write(chrome / "rice.css", firefox_css)

    pywalfox = HOME / ".local/share/refox/venv/bin/pywalfox"
    if pywalfox.exists():
        run([str(pywalfox), c.get("mode", "dark")])
        run([str(pywalfox), "update"])

    # Keep a ready-to-apply Spicetify theme beside the live palette. Spotify
    # itself has no GTK theme hook, so this becomes active only when Spicetify
    # is installed and supports the locally installed Spotify build.
    spotify = HOME / ".config/spicetify/Themes/Rice"
    nohash = lambda color: color.lstrip("#")
    write(spotify / "color.ini", f"""; Generated by Paperss — do not edit by hand.
[Base]
main = {nohash(surface)}
sidebar = {nohash(low)}
player = {nohash(surface)}
card = {nohash(high)}
shadow = 000000
selected-row = {nohash(high)}
button = {nohash(alternate)}
button-active = {nohash(accent)}
button-disabled = {nohash(muted)}
tab-active = {nohash(high)}
notification = {nohash(alternate)}
notification-error = {nohash(danger)}
misc = {nohash(muted)}
text = {nohash(text)}
subtext = {nohash(c['on_surface_variant'])}
""")
    write(spotify / "user.css", """/* Paperss spacing and soft card treatment. */
.main-card-card, .main-home-homeHeader, .main-entityHeader-backgroundColor {
  border-radius: 10px;
}
.main-trackList-trackListRow:hover {
  border-radius: 7px;
}
""")

    spicetify = HOME / ".spicetify/spicetify"
    config = HOME / ".config/spicetify/config-xpui.ini"
    if spicetify.exists() and config.exists():
        run([str(spicetify), "refresh", "-n"])

    # Each command is a no-op if it is outside the active desktop session.
    hypr_env = hyprland_env()
    if hypr_env:
        run(["hyprctl", "reload"], env=hypr_env)
    run(["pkill", "-SIGUSR2", "waybar"])
    run(["makoctl", "reload"])

    # Restarting swaybg is the portable way to show the selected image.
    # Launch through Hyprland so the wallpaper process belongs to the compositor
    # and survives this command's process namespace.
    # process namespace (including when a palette reload comes from automation).
    wallpaper_path = Path(wallpaper).expanduser() if wallpaper else None
    if hypr_env and wallpaper_path and wallpaper_path.exists() and shutil.which("swaybg"):
        replace = (
            "pkill -x swaybg >/dev/null 2>&1 || true; "
            f"exec swaybg -i {shlex.quote(str(wallpaper_path))} -m fill"
        )
        command = shlex.join(["sh", "-lc", replace])
        run(["hyprctl", "dispatch", "exec", command], env=hypr_env)


if __name__ == "__main__":
    main()

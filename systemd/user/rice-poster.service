[Unit]
Description=Regenerate the root-window collage from today's activity
Documentation=file:///home/jinho/.local/share/rice/README.md
After=graphical-session.target

[Service]
Type=oneshot
# The session bus and display are needed for gsettings to reach the running
# GNOME session; a timer-launched unit doesn't inherit them.
Environment=DISPLAY=:0
ExecStart=/home/jinho/.local/bin/poster --apply

#!/usr/bin/env python3
"""poster — generate the JINHO wallpaper from today's actual activity.

    poster                       # render today's poster
    poster --apply               # render it, set it, and retheme the desktop
    poster --seed '#040480'      # force a hue instead of drifting
    poster --date 2026-07-19     # render a past day
    poster --preview             # also write a small preview to /tmp

The composition is drawn procedurally — masthead, task list, activity ribbon,
footer marks — so it has no source-image dependency and every element can be
driven by data. The body is the live task list (edit it with `todo`); the
ribbon along the base is real per-hour focus time, and the footer names the
repo you actually worked in.
"""
import argparse
import calendar
import colorsys
import getpass
import json
import math
import os
import platform
import random
import shutil
import subprocess
import sys
import textwrap
import tomllib
from datetime import datetime
from pathlib import Path

sys.path.insert(0, str(Path.home() / ".local/share/rice/lib"))
import ricedata as R  # noqa: E402

try:
    from PIL import Image, ImageDraw, ImageFilter, ImageFont, ImageOps
except ImportError:
    sys.exit("poster needs Pillow:  pip install --user Pillow")

HOME = Path.home()
SERIF = HOME / ".local/share/fonts/PlayfairDisplay-var.ttf"
MONO = HOME / ".local/share/fonts/FiraCodeNerdFont/FiraCodeNerdFontMono-Medium.ttf"
ROMAN = Path("/usr/share/fonts/opentype/urw-base35/NimbusRoman-Regular.otf")
OUT = HOME / "Pictures/Wallpapers/jinho-poster-generated.png"
ASCII = HOME / "Downloads/ascii-art.txt"
LAYOUT = HOME / ".local/share/rice/poster.toml"
ART_MAIN = HOME / ".local/share/rice/art/processed/pines-01-main.png"
ART_DETAIL = HOME / ".local/share/rice/art/processed/pines-01-detail.png"

W, H = 3840, 2400          # 2x of the 1920x1200 panel, for crisp downscaling
M = int(W * 0.033)         # outer margin


# ---------------------------------------------------------------- color utils

def hex_rgb(h):
    h = h.lstrip("#")
    return tuple(int(h[i:i + 2], 16) for i in (0, 2, 4))


def mix(a, b, t):
    return tuple(int(round(x + (y - x) * t)) for x, y in zip(a, b))


def shift_hue(hexcolor, degrees):
    r, g, b = (c / 255 for c in hex_rgb(hexcolor))
    h, l, s = colorsys.rgb_to_hls(r, g, b)
    r, g, b = colorsys.hls_to_rgb((h + degrees / 360.0) % 1.0, l, s)
    return "#%02x%02x%02x" % tuple(int(round(c * 255)) for c in (r, g, b))


def serif(size, weight=600):
    f = ImageFont.truetype(str(SERIF), size)
    try:
        f.set_variation_by_axes([weight])
    except Exception:
        pass  # static build of the font — weight axis just won't apply
    return f


def mono(size):
    return ImageFont.truetype(str(MONO), size)


def roman(size):
    return ImageFont.truetype(str(ROMAN), size)


def tracked(s, spaces=1):
    return (" " * spaces).join(str(s))


# ------------------------------------------------------------------- drawing

def stretched(img, word, box, color, weight=640, alpha=255):
    """Draw `word` scaled to exactly fill `box` — the didone masthead effect.

    Rendering large then resizing (rather than picking a point size) is what
    lets the letterforms stretch to the box's proportions instead of merely
    fitting inside it.
    """
    x0, y0, x1, y1 = box
    bw, bh = x1 - x0, y1 - y0
    if bw <= 0 or bh <= 0 or not word:
        return
    font = serif(400, weight)
    bbox = font.getbbox(word)
    tw, th = bbox[2] - bbox[0], bbox[3] - bbox[1]
    if tw <= 0 or th <= 0:
        return
    layer = Image.new("L", (tw, th), 0)
    ImageDraw.Draw(layer).text((-bbox[0], -bbox[1]), word, font=font, fill=255)
    mask = layer.resize((bw, bh), Image.LANCZOS)
    if alpha < 255:
        mask = mask.point(lambda v: int(v * alpha / 255))
    img.paste(Image.new("RGB", (bw, bh), color), (x0, y0), mask)


def activity_ribbon(draw, snap, base_y, colors):
    """Per-hour focus time as a row of columns across the poster's base."""
    hourly = snap["hourly"]
    peak = max(hourly) or 1.0
    x0, x1 = M, W - M
    span = x1 - x0
    slot = span / 24.0
    gap = slot * 0.22
    max_h = int(H * 0.072)
    now_hour = datetime.now().hour

    for hour, secs in enumerate(hourly):
        frac = secs / peak
        bx0 = x0 + hour * slot
        bx1 = bx0 + slot - gap
        # Every hour keeps a hairline so the axis stays legible when idle.
        bh = max(3, int(max_h * frac))
        if frac > 0.02:
            c = mix(hex_rgb(colors["outline"]), hex_rgb(colors["primary"]),
                    0.35 + 0.65 * frac)
        else:
            c = mix(hex_rgb(colors["surface"]), hex_rgb(colors["outline"]), 0.45)
        draw.rectangle((bx0, base_y - bh, bx1, base_y), fill=c)
        # Mark the current hour with a tick below the axis.
        if hour == now_hour and snap["date"] == datetime.now().strftime("%Y-%m-%d"):
            draw.rectangle((bx0, base_y + 10, bx1, base_y + 18),
                           fill=hex_rgb(colors["primary"]))

    hour_font = mono(26)
    for hour in (0, 6, 12, 18):
        label = f"{hour:02d}"
        draw.text((x0 + hour * slot, base_y + 34), label,
                  font=hour_font, fill=mix(hex_rgb(colors["surface"]),
                                           hex_rgb(colors["outline"]), 0.75))


def task_list(img, draw, items, box, colors, limit=8):
    """The day's tasks, as checkboxes down the poster's body.

    Rows are sized to the number of tasks rather than fixed, so a two-item list
    reads as a bold statement and a full one still fits without scrolling off
    the ribbon.
    """
    x0, y0, x1, y1 = box
    # Muted well below on_surface so the tasks whisper; the checkbox accent
    # carries the emphasis. Blend outline toward on_surface_variant.
    ink = mix(hex_rgb(colors["outline"]), hex_rgb(colors["on_surface_variant"]), 0.45)
    dim = hex_rgb(colors["outline"])
    accent = hex_rgb(colors["primary"])

    shown = items[:limit]
    overflow = len(items) - len(shown)

    if not shown:
        f = serif(int(H * 0.026), 500)
        draw.text((x0, y0), "nothing on the list", font=f,
                  fill=mix(hex_rgb(colors["surface"]), dim, 0.7))
        return

    # Small, fixed type — subtle, and stable regardless of task count. Long
    # tasks wrap onto extra lines rather than being trimmed to one.
    text_size = int(H * 0.023)
    f = serif(text_size, 460)
    line_h = int(text_size * 1.2)
    box_side = int(text_size * 1.1)
    gap = int(box_side * 0.85)
    row_gap = int(text_size * 0.95)       # breathing room between tasks
    max_lines = 3

    def wrap(text):
        words, lines, cur = text.split(), [], ""
        for w in words:
            trial = f"{cur} {w}".strip()
            if not cur or draw.textlength(trial, font=f) <= avail:
                cur = trial
            else:
                lines.append(cur)
                cur = w
        if cur:
            lines.append(cur)
        if len(lines) > max_lines:                    # trim the last visible line
            lines = lines[:max_lines]
            last = lines[-1]
            while last and draw.textlength(last + "…", font=f) > avail:
                last = last[:-1]
            lines[-1] = last + "…"
        return lines

    tx = x0 + box_side + gap
    avail = x1 - tx
    y = y0
    drawn = 0

    for item in shown:
        lines = wrap(item["text"])
        row_h = max(box_side, len(lines) * line_h)
        if y + row_h > y1:                             # ran out of card height
            break
        done = bool(item.get("done"))
        color = mix(hex_rgb(colors["surface"]), dim, 0.8) if done else ink

        # Checkbox aligned to the centre of the first text line.
        fcy = y + line_h / 2
        bx0, by0 = x0, int(fcy - box_side / 2)
        bx1, by1 = x0 + box_side, by0 + box_side
        if done:
            draw.rounded_rectangle((bx0, by0, bx1, by1), radius=int(box_side * 0.22),
                                   fill=accent)
            draw.line([(bx0 + box_side * 0.24, by0 + box_side * 0.52),
                       (bx0 + box_side * 0.42, by0 + box_side * 0.71),
                       (bx0 + box_side * 0.77, by0 + box_side * 0.29)],
                      fill=hex_rgb(colors["surface"]),
                      width=max(4, int(box_side * 0.12)), joint="curve")
        else:
            draw.rounded_rectangle((bx0, by0, bx1, by1), radius=int(box_side * 0.22),
                                   outline=dim, width=max(3, int(box_side * 0.07)))

        for j, ln in enumerate(lines):
            bb = draw.textbbox((0, 0), ln, font=f)
            ly = int(y + j * line_h + (line_h - (bb[3] + bb[1])) / 2)
            draw.text((tx, ly), ln, font=f, fill=color)
            if done:
                sy = int(y + j * line_h + line_h / 2)
                draw.line([(tx, sy), (tx + draw.textlength(ln, font=f), sy)],
                          fill=color, width=max(2, int(text_size * 0.05)))

        y += row_h + row_gap
        drawn += 1

    overflow += len(shown) - drawn
    if overflow > 0:
        fo = mono(int(text_size * 0.62))
        draw.text((tx, y + row_gap * 0.2), tracked(f"+{overflow} MORE"),
                  font=fo, fill=dim)


def monogram(draw, box, colors, initials="JB", year="2026"):
    x0, y0, x1, y1 = box
    ink = hex_rgb(colors["on_surface_variant"])
    draw.rounded_rectangle((x0, y0, x1, y1), radius=14, outline=ink, width=6)
    draw.rounded_rectangle((x0 + 14, y0 + 14, x1 - 14, y1 - 14), radius=8,
                           outline=ink, width=2)
    f = serif(int((x1 - x0) * 0.52), 640)
    bb = draw.textbbox((0, 0), initials, font=f)
    draw.text(((x0 + x1) / 2 - (bb[2] - bb[0]) / 2 - bb[0], y0 + (y1 - y0) * 0.17 - bb[1]),
              initials, font=f, fill=ink)
    fy = mono(int((x1 - x0) * 0.12))
    t = tracked(year)
    draw.text(((x0 + x1) / 2 - draw.textlength(t, font=fy) / 2, y1 - (y1 - y0) * 0.26),
              t, font=fy, fill=ink)


def ascii_art(img, box, colors, path):
    """Render a text ascii-art file to fill `box`, tinted to the palette.

    The glyph coverage of the density characters (+ = * # @ …) is used as an
    alpha mask, so the art reads as a soft monochrome image over the surface
    rather than literal text. It's cropped to its own content bounds and scaled
    to fit the box while keeping its aspect ratio, then centred.
    """
    x0, y0, x1, y1 = box
    bw, bh = x1 - x0, y1 - y0
    if bw <= 0 or bh <= 0:
        return
    try:
        raw = Path(path).expanduser().read_text().split("\n")
    except OSError:
        return

    # Crop to the bounding box of non-blank content.
    rows = [i for i, l in enumerate(raw) if l.strip()]
    if not rows:
        return
    block = raw[rows[0]:rows[-1] + 1]
    left = min(len(l) - len(l.lstrip()) for l in block if l.strip())
    right = max(len(l.rstrip()) for l in block)
    block = [l[left:right] for l in block]
    ncols = max((len(l) for l in block), default=1)
    nrows = len(block)

    # Draw at a fixed cell size, then downscale — crisper than picking a size
    # that happens to fit, and lets one code path handle any art dimensions.
    f = mono(28)
    adv = f.getlength("M")
    asc, desc = f.getmetrics()
    line_h = asc + desc
    lw = max(1, int(adv * ncols) + 4)
    lh = max(1, int(line_h * nrows) + 4)
    layer = Image.new("L", (lw, lh), 0)
    ld = ImageDraw.Draw(layer)
    for i, line in enumerate(block):
        if line.strip():
            ld.text((0, i * line_h), line, font=f, fill=255)

    scale = min(bw / lw, bh / lh)
    tw, th = max(1, int(lw * scale)), max(1, int(lh * scale))
    mask = layer.resize((tw, th), Image.LANCZOS)
    px = x0 + (bw - tw) // 2
    py = y0 + (bh - th) // 2
    solid = Image.new("RGB", (tw, th), hex_rgb(colors["on_surface_variant"]))
    img.paste(solid, (px, py), mask)


def render_legacy(snap, colors, name="TODO", ascii_path=None):
    surface = hex_rgb(colors["surface"])
    paper = hex_rgb(colors["on_surface"])

    img = Image.new("RGB", (W, H), surface)
    draw = ImageDraw.Draw(img)

    todos = R.load_todos()
    open_count = sum(1 for t in todos if not t.get("done"))

    # --- top two-thirds: ascii art on the left, the task list boxed at right ---
    # The list is confined to a vertical card on the right; the rest of the
    # upper canvas is given over to the ascii-art image beside it.
    top_bottom = int(H * 0.72)
    card_w = int(W * 0.25)
    card_bottom = int(H * 0.50)
    gutter = int(W * 0.03)
    card_x1 = W - M
    card_x0 = card_x1 - card_w

    ascii_art(img, (M, M, card_x0 - gutter, top_bottom), colors,
              ascii_path or ASCII)

    # The card: a lifted panel so the list reads as its own object.
    draw.rounded_rectangle((card_x0, M, card_x1, card_bottom),
                           radius=int(W * 0.012),
                           fill=hex_rgb(colors["surface_container"]),
                           outline=hex_rgb(colors["outline_variant"]), width=4)
    cm = int(card_w * 0.075)          # card inner margin

    # masthead: the title set large in the accent serif directly on the card,
    # with the count and a hairline rule beneath it — no reversed bar.
    inner_x0 = card_x0 + cm
    inner_x1 = card_x1 - cm
    inner_w = inner_x1 - inner_x0

    # Scale the serif so the word nearly spans the card's inner width.
    probe = serif(400, 640)
    pw = draw.textlength(name, font=probe) or 1
    tf = serif(int(400 * inner_w * 0.94 / pw), 640)
    tb = draw.textbbox((0, 0), name, font=tf)
    title_y = M + cm
    draw.text((inner_x0 - tb[0], title_y - tb[1]), name, font=tf,
              fill=hex_rgb(colors["primary"]))
    cursor = title_y + (tb[3] - tb[1]) + int(H * 0.024)

    # open/total count in tracked mono.
    fc = mono(int(H * 0.028))
    tally = tracked(f"{open_count} OPEN / {len(todos)}" if todos else "EMPTY")
    draw.text((inner_x0, cursor), tally, font=fc,
              fill=hex_rgb(colors["on_surface_variant"]))
    cursor += int(H * 0.05)

    # hairline rule between the header and the list.
    draw.line((inner_x0, cursor, inner_x1, cursor),
              fill=hex_rgb(colors["outline_variant"]), width=3)
    list_top = cursor + int(H * 0.03)

    # --- the list itself, down the body of the card ---
    task_list(img, draw, todos,
              (inner_x0, list_top, inner_x1, card_bottom - cm), colors)

    # --- activity ribbon along the base ---
    # The whole bottom band sits low on the canvas; its left/right marks hug the
    # edges, clear of the dock that floats over the centre of the last ~10%.
    activity_ribbon(draw, snap, int(H * 0.85), colors)

    # --- footer marks ---
    ink = hex_rgb(colors["on_surface_variant"])
    year = snap["date"][:4]
    f_cap = mono(30)
    foot_y = int(H * 0.945)
    repo = snap.get("top_repo") or "HOME"
    draw.text((M, foot_y), tracked(f"~/{repo}".upper()), font=f_cap, fill=ink)

    stamp_w = int(W * 0.052)
    stamp_cy = int(H * 0.915)
    stamp = (W - M - stamp_w, stamp_cy - int(stamp_w * 0.65),
             W - M, stamp_cy + int(stamp_w * 0.70))

    right_x = stamp[0] - int(W * 0.022)
    lines = [
        snap["date"].replace("-", " · "),
        f"{R.fmt_duration(snap['total_secs'])} FOCUSED",
    ]
    for i, line in enumerate(lines):
        t = tracked(line)
        draw.text((right_x - draw.textlength(t, font=f_cap), foot_y - i * 44),
                  t, font=f_cap, fill=ink)

    monogram(draw, stamp, colors, year=year)
    return img


# ---------------------------------------------------------- root-window collage

DEFAULT_LAYOUT = {
    "system": {"x": 0.06, "y": 0.05, "w": 0.28, "h": 0.20},
    "main_art": {"x": -0.04, "y": 0.30, "w": 0.55, "h": 0.50},
    "preview": {"x": 0.63, "y": 0.10, "w": 0.25, "h": 0.18},
    "recent": {"x": 0.39, "y": 0.43, "w": 0.31, "h": 0.15},
    "todo": {"x": 0.80, "y": 0.35, "w": 0.15, "h": 0.18, "max_h": 0.37},
    "focus": {"x": 0.71, "y": 0.79, "w": 0.22, "h": 0.10},
}


def load_layout(defaults=None):
    """Load normalized component boxes; malformed entries fall back safely.

    `defaults` selects which component set is in play — each style has its own,
    and a style only ever reads the names it draws, so one poster.toml can hold
    boxes for several styles without them colliding.
    """
    defaults = DEFAULT_LAYOUT if defaults is None else defaults
    layout = {k: dict(v) for k, v in defaults.items()}
    if not LAYOUT.exists():
        return layout
    try:
        raw = tomllib.loads(LAYOUT.read_text()).get("components", {})
    except (OSError, tomllib.TOMLDecodeError):
        return layout
    for name, values in raw.items():
        if name not in layout or not isinstance(values, dict):
            continue
        # Only keys the component already defines are honored, so a typo in the
        # file can't invent geometry the drawing code never reads.
        for key, value in values.items():
            if key in layout[name] and isinstance(value, (int, float)):
                layout[name][key] = float(value)
    return layout


def component_box(layout, name):
    b = layout[name]
    return (int(W * b["x"]), int(H * b["y"]),
            int(W * (b["x"] + b["w"])), int(H * (b["y"] + b["h"])))


def todo_box(layout, items):
    """The todo window, grown downward to hold its tasks.

    Only the bottom edge moves: `h` stays the floor so a short list still reads
    as a window rather than a sliver, and `max_h` is the ceiling that keeps the
    frame clear of the focus plot below it.
    """
    x0, y0, x1, y1 = component_box(layout, "todo")
    cap = int(H * layout["todo"].get("max_h", DEFAULT_LAYOUT["todo"]["max_h"]))
    need = y0 + todo_height(todo_rows(items))
    return (x0, y0, x1, max(y1, min(need, y0 + cap)))


def root_colors(colors):
    """Collapse Material's palette to the restrained four-tone root palette."""
    return {
        "root": hex_rgb(colors.get("surface_lowest", "#0e0e0e")),
        "panel": hex_rgb(colors.get("surface", "#131313")),
        "ink": hex_rgb(colors.get("on_surface", "#e2e2e2")),
        "muted": hex_rgb(colors.get("on_surface_variant", "#c6c6c6")),
        "line": hex_rgb(colors.get("outline", "#919191")),
        "dim": hex_rgb(colors.get("outline_variant", "#474747")),
    }


def window(draw, box, palette, title=None, fill=True):
    """A deliberately plain X11-like program frame: sharp and one-pixel."""
    x0, y0, x1, y1 = box
    if fill:
        draw.rectangle(box, fill=palette["root"])
    draw.rectangle(box, outline=palette["line"], width=2)
    if title:
        f = mono(22)
        label = f" {title} "
        draw.rectangle((x0 + 16, y0 - 2, x0 + 20 + draw.textlength(label, font=f),
                        y0 + 24), fill=palette["root"])
        draw.text((x0 + 20, y0 - 1), label, font=f, fill=palette["muted"])


def paste_ink(img, path, box, color, contain=True, opacity=255):
    """Use black marks on white art as an alpha mask painted in theme ink."""
    try:
        art = Image.open(path).convert("L")
    except OSError:
        return
    mask = ImageOps.invert(art)
    x0, y0, x1, y1 = box
    bw, bh = max(1, x1 - x0), max(1, y1 - y0)
    scale = min(bw / art.width, bh / art.height) if contain else max(
        bw / art.width, bh / art.height)
    nw, nh = max(1, int(art.width * scale)), max(1, int(art.height * scale))
    mask = mask.resize((nw, nh), Image.Resampling.LANCZOS)
    if opacity != 255:
        mask = mask.point(lambda v: int(v * opacity / 255))
    # Main artwork is bottom-left anchored; detail views are centred.
    px = x0 if not contain else x0 + (bw - nw) // 2
    py = y1 - nh if not contain else y0 + (bh - nh) // 2
    img.paste(Image.new("RGB", (nw, nh), color), (px, py), mask)


def system_snapshot():
    """Small stable system facts without another dependency or subprocess."""
    values = {
        "user": getpass.getuser(),
        "host": platform.node().split(".")[0] or "localhost",
        "os": platform.system(),
        "kernel": platform.release(),
        "cpu": platform.machine(),
        "uptime": "—",
        "memory": "—",
        "disk": "—",
    }
    try:
        osr = {}
        for line in Path("/etc/os-release").read_text().splitlines():
            if "=" in line:
                key, value = line.split("=", 1)
                osr[key] = value.strip().strip('"')
        values["os"] = osr.get("PRETTY_NAME", values["os"])
    except OSError:
        pass
    try:
        for line in Path("/proc/cpuinfo").read_text().splitlines():
            if line.startswith("model name"):
                values["cpu"] = line.split(":", 1)[1].strip()
                break
    except OSError:
        pass
    try:
        seconds = float(Path("/proc/uptime").read_text().split()[0])
        hours, minutes = int(seconds // 3600), int((seconds % 3600) // 60)
        values["uptime"] = f"{hours}h {minutes:02d}m"
    except (OSError, ValueError, IndexError):
        pass
    try:
        mem = {}
        for line in Path("/proc/meminfo").read_text().splitlines():
            key, value = line.split(":", 1)
            mem[key] = int(value.split()[0])
        used = mem["MemTotal"] - mem.get("MemAvailable", mem.get("MemFree", 0))
        values["memory"] = f"{used / 1048576:.1f}G / {mem['MemTotal'] / 1048576:.1f}G"
    except (OSError, ValueError, KeyError):
        pass
    try:
        usage = shutil.disk_usage(HOME)
        values["disk"] = f"{usage.used / 2**30:.0f}G / {usage.total / 2**30:.0f}G"
    except OSError:
        pass
    return values


def draw_system(draw, box, palette):
    window(draw, box, palette, "sys")
    x0, y0, x1, y1 = box
    data = system_snapshot()
    head = mono(26)
    body = mono(23)
    dim = mono(21)
    left, top = x0 + 34, y0 + 42
    draw.text((left, top), f"{data['user']}@{data['host']}", font=head,
              fill=palette["ink"])
    rows = [
        ("os", data["os"]), ("kernel", data["kernel"]),
        ("cpu", data["cpu"]), ("session", "GNOME / Wayland"),
        ("uptime", data["uptime"]), ("memory", data["memory"]),
        ("disk", data["disk"]),
    ]
    y = top + 46
    value_x = left + 150
    max_value_w = x1 - value_x - 26
    for key, value in rows:
        value = str(value)
        while value and draw.textlength(value, font=body) > max_value_w:
            value = value[:-1]
        draw.text((left, y), key, font=body, fill=palette["dim"])
        draw.text((value_x, y), value, font=body, fill=palette["muted"])
        y += 34
    prompt_y = min(y1 - 48, y + 22)
    draw.text((left, prompt_y), "$", font=head, fill=palette["ink"])
    draw.rectangle((left + 34, prompt_y + 25, left + 52, prompt_y + 28),
                   fill=palette["ink"])
    draw.text((x1 - 136, y1 - 34), "pid 01", font=dim, fill=palette["dim"])


def draw_preview(img, draw, box, palette):
    x0, y0, x1, y1 = box
    draw.rectangle(box, fill=palette["root"])
    paste_ink(img, ART_DETAIL, (x0 + 18, y0 + 24, x1 - 18, y1 - 18),
              palette["ink"], contain=True)
    window(draw, box, palette, "view/ink", fill=False)


def draw_recent(draw, snap, box, palette):
    window(draw, box, palette, "~/recent")
    x0, y0, x1, y1 = box
    f = mono(22)
    small = mono(19)
    rows = []
    for repo, edits in snap.get("repos", [])[:2]:
        rows.append((Path(repo).name if repo else "unknown", f"{int(edits)} edits"))
    for app, seconds in snap.get("apps", [])[:max(0, 4 - len(rows))]:
        rows.append((f"app/{str(app).lower()}", R.fmt_duration(seconds).lower()))
    if not rows:
        rows = [("no activity", "idle")]

    # The inverse row is a neutral scope header, never the top repository.
    y = y0 + 40
    row_h = 45
    draw.rectangle((x0 + 20, y - 4, x1 - 20, y + row_h - 8),
                   fill=palette["ink"])
    draw.text((x0 + 34, y), "scope/today", font=f, fill=palette["root"])
    draw.text((x1 - 34 - draw.textlength("delta", font=small), y + 2), "delta",
              font=small, fill=palette["root"])
    y += row_h
    for name, label in rows:
        fg = palette["muted"]
        shown = name
        max_name = (x1 - x0) * 0.62
        while shown and draw.textlength(shown, font=f) > max_name:
            shown = shown[:-1]
        draw.text((x0 + 34, y), shown, font=f, fill=fg)
        draw.text((x1 - 34 - draw.textlength(label, font=small), y + 2), label,
                  font=small, fill=fg)
        y += row_h
    draw.text((x0 + 34, y1 - 30), "repository + application activity",
              font=small, fill=palette["dim"])


TODO_TOP = 48       # first row, clear of the window's title tab
TODO_LINE = 32      # one wrapped line of task text
TODO_PAD = 18       # breathing room under a row
TODO_ROW = 52       # floor row height, so one-line tasks don't crowd
TODO_TALLY = 60     # reserved at the base for the shown/open line


def todo_rows(items):
    """Wrapped lines for each open task, in draw order."""
    return [textwrap.wrap(i["text"], width=26)[:2] or [i["text"]]
            for i in items if not i.get("done")]


def todo_height(rows):
    """Height the window needs to show every row of `rows`."""
    body = sum(max(TODO_ROW, len(r) * TODO_LINE + TODO_PAD) for r in rows)
    return TODO_TOP + body + TODO_TALLY


def draw_todo(draw, items, box, palette):
    window(draw, box, palette, "todo")
    x0, y0, x1, y1 = box
    f = roman(29)
    mono_small = mono(18)
    available = x1 - x0 - 82
    y = y0 + TODO_TOP
    rows = todo_rows(items)
    if not rows:
        draw.text((x0 + 28, y), "nothing pending", font=f, fill=palette["dim"])
    shown = 0
    for lines in rows:
        row_h = max(TODO_ROW, len(lines) * TODO_LINE + TODO_PAD)
        if y + row_h > y1 - TODO_TALLY:      # would cross the frame; stop here
            break
        draw.text((x0 + 28, y), "[ ]", font=mono_small, fill=palette["line"])
        for j, line in enumerate(lines):
            while line and draw.textlength(line, font=f) > available:
                line = line[:-1]
            draw.text((x0 + 78, y - 5 + j * TODO_LINE), line, font=f,
                      fill=palette["muted"])
        y += row_h
        shown += 1
    tally = f"{shown} shown / {len(rows)} open"
    draw.text((x0 + 28, y1 - 34), tally, font=mono_small, fill=palette["dim"])


def compact_focus(hourly):
    blocks = "·▁▂▃▄▅▆▇█"
    peak = max(hourly) or 1
    vals = [max(hourly[i], hourly[i + 1]) for i in range(0, 24, 2)]
    return "".join(blocks[min(8, round(8 * value / peak))] for value in vals)


def draw_focus(draw, snap, box, palette):
    x0, y0, x1, y1 = box
    label = mono(20)
    graph = mono(38)
    draw.text((x0, y0), "focus/24h", font=label, fill=palette["dim"])
    draw.text((x0, y0 + 34), compact_focus(snap["hourly"]), font=graph,
              fill=palette["ink"])
    total = f"{R.fmt_duration(snap['total_secs']).lower()} focused"
    draw.text((x0, min(y1 - 24, y0 + 90)), total, font=label, fill=palette["muted"])


# ------------------------------------------------------- deserted / System 7
#
# A second style: the ink artwork repainted as a tiled impasto field, with the
# same truthful utilities drawn over it as cream System 7 program windows.
#
# The painting is expensive to generate (tens of thousands of individual
# strokes) but depends only on the palette and the source art, so it is cached
# on disk and the hourly poster run reuses it. Only the windows are redrawn.

IMPASTO_PNG = HOME / ".local/share/rice/art/processed/impasto-field.png"
IMPASTO_KEY = HOME / ".local/share/rice/art/processed/impasto-field.json"
ART_SOURCE = HOME / ".local/share/rice/art/source/pines-01.png"

DESERTED_LAYOUT = {
    "calendar": {"x": 0.400, "y": 0.275, "w": 0.140, "h": 0.170},
    "fetch": {"x": 0.250, "y": 0.495, "w": 0.225, "h": 0.205},
    "threads": {"x": 0.545, "y": 0.245, "w": 0.220, "h": 0.500},
    "todo": {"x": 0.795, "y": 0.510, "w": 0.150, "h": 0.150, "max_h": 0.330},
    "focus": {"x": 0.070, "y": 0.800, "w": 0.200, "h": 0.100},
}


def luma(rgb):
    return 0.2126 * rgb[0] + 0.7152 * rgb[1] + 0.0722 * rgb[2]


# `colors.json` publishes Material's container roles under short names, so the
# M3 spelling never matched and every lookup below fell through to its default.
# That went unnoticed for as long as the defaults and the palette were both
# cream — the light theme wanted those exact values anyway. It only surfaced in
# dark mode, as three hardcoded light stops in an otherwise dark ramp and a
# System 7 window still papered in #f2efe2.
ROLE_ALIASES = {
    "surface_container_lowest": "surface_lowest",
    "surface_container_low": "surface_low",
    "surface_container_high": "surface_high",
    "surface_container_highest": "surface_highest",
}


def role(colors, name, default):
    """A palette role, under whichever of its two names the palette carries."""
    for key in (name, ROLE_ALIASES.get(name)):
        if key and key in colors:
            return colors[key]
    return default


# The ramp has two ends: the field the painting is mostly made of, and the
# marks scattered across it. Which palette roles play those parts flips with
# the palette's polarity — in a light palette the field is the surface family
# and the marks are the `on_` roles, and in a dark one it is the other way
# round. The second index is the one `tertiary` sits at; see below.
#
# The dark set is deliberately not the light set reversed. It stops short of
# `on_surface`, and thickens the field end with two more container tones,
# because a dark palette's brightest role is near-white while a light one's
# darkest is a soft brown: an even mirror puts white where the light theme has
# only a gentle olive, and the drawing's ink mass — which is not sparse at all
# once the noise octaves have smeared it — comes back as white blooms over a
# third of the screen. Capping the bright end at `on_surface_variant` keeps the
# marks as warm highlights, which is what the light field's marks are too.
LIGHT_RAMP = (
    ("on_surface", "#201b13"),
    ("on_surface_variant", "#504535"),
    ("tertiary", "#4e6543"),
    ("outline", "#827663"),
    ("surface_container_high", "#d9c6ac"),
    ("surface", "#ded6bd"),
    ("surface_container_lowest", "#e4dfc6"),
)
DARK_RAMP = (
    ("on_surface_variant", "#d4c5b0"),
    ("outline", "#9c8f7c"),
    ("tertiary", "#b4cea5"),
    ("outline_variant", "#504535"),
    ("surface_container_highest", "#3f331e"),
    ("surface_container_high", "#342814"),
    ("surface", "#1f1100"),
)


def is_dark(colors):
    """Whether the palette puts its text above its surfaces on the L axis."""
    return luma(hex_rgb(role(colors, "surface", "#ded6bd"))) < \
        luma(hex_rgb(role(colors, "on_surface", "#201b13")))


def ramp_lut(colors):
    """A 256-entry luminance->RGB ramp built from real palette roles.

    The stops are sorted by their own luminance rather than assumed to be in
    order, so the ramp stays monotonic whatever palette is loaded — a seed that
    happens to produce a dark `tertiary` can't invert the painting.
    """
    dark = is_dark(colors)
    stops = [hex_rgb(role(colors, k, d)) for k, d in
             (DARK_RAMP if dark else LIGHT_RAMP)]
    # `tertiary` is the one stop M3 picks for contrast rather than for harmony,
    # so at full strength it fluoresces against a field made of neutrals. Pulled
    # most of the way to its neighbour it still tilts the midtones — the sage
    # cast the reference has — without becoming a separate color event.
    stops[2] = mix(stops[2], stops[1], 0.55)
    stops.sort(key=luma)

    # The ramp is indexed by the *source drawing's* luminance, and that drawing
    # is ink on white paper — the bulk of it sits at the top of the index. So
    # the top of the ramp is what the field is mostly made of, and it has to be
    # whatever the palette calls "the surface you put things on": near-white for
    # a light palette, espresso for a dark one. Ascending order always puts the
    # palette's lightest tone there, which painted the dark theme's wallpaper
    # the same cream as the light theme's and left the whole switch looking like
    # it had not taken. Flipping the ramp makes the paper of the drawing read as
    # the dark field and its ink as the marks on top — the same painting,
    # printed in negative.
    if dark:
        stops.reverse()

    lut = []
    span = len(stops) - 1
    for v in range(256):
        pos = v / 255 * span
        i = min(span - 1, int(pos))
        t = pos - i
        lut.append(mix(stops[i], stops[i + 1], t))
    return lut


def value_noise(w, h, cells, rng):
    """Smooth low-frequency noise, made by upscaling a tiny random image."""
    ch = max(2, int(cells * h / w))
    small = Image.new("L", (cells, ch))
    small.putdata([rng.randrange(256) for _ in range(cells * ch)])
    return small.resize((w, h), Image.Resampling.BICUBIC)


def impasto_tile(tw, th, lut, rng, strokes=150000):
    """Repaint the ink artwork as thick oriented brushwork.

    Stroke direction follows the *perpendicular* of the local luminance
    gradient, which is the direction the form runs in — that is what makes the
    marks comb around shapes instead of hatching across them. Flat areas have
    no meaningful gradient, so they fall back to a slowly drifting base angle,
    which is what gives the field its cloud-like sweep.
    """
    try:
        art = Image.open(ART_SOURCE).convert("L")
    except OSError:
        art = Image.new("L", (tw, th), 235)
    art = ImageOps.fit(art, (tw, th), Image.Resampling.LANCZOS)
    # The source is a sparse ink drawing: near-pure black marks on near-pure
    # white. Left alone it tiles into hard blobs of pigment floating in a void.
    # Compressing its range first turns the subject into a soft dark mass that
    # the brushwork can sit inside, which is how it reads as a painted scene
    # rather than a scan of a drawing.
    art = art.point(lambda v: 58 + v * 180 // 255)

    # Three octaves of cloud, so the paper of the source drawing becomes a
    # modulated sky rather than a flat slab.
    noise = Image.blend(value_noise(tw, th, 7, rng),
                        value_noise(tw, th, 19, rng), 0.42)
    noise = Image.blend(noise, value_noise(tw, th, 54, rng), 0.22)
    field = Image.blend(art, noise, 0.42)
    field = field.filter(ImageFilter.GaussianBlur(tw / 520))

    canvas = Image.merge("RGB", [field.point([c[i] for c in lut])
                                 for i in range(3)])
    d = ImageDraw.Draw(canvas)
    px = field.load()

    slen = tw / 118.0           # stroke length
    swid = max(2, int(tw / 330))
    grad = max(2, int(tw / 320))
    base = rng.uniform(0, math.pi)
    for i in range(strokes):
        if i % 2200 == 0:       # let the sweep wander across the canvas
            base += rng.gauss(0, 0.26)
        x = rng.randrange(tw)
        y = rng.randrange(th)
        v = px[x, y]
        gx = px[min(x + grad, tw - 1), y] - px[max(x - grad, 0), y]
        gy = px[x, min(y + grad, th - 1)] - px[x, max(y - grad, 0)]
        if abs(gx) + abs(gy) < 8:
            ang = base + rng.gauss(0, 0.32)
        else:
            ang = math.atan2(gy, gx) + math.pi / 2 + rng.gauss(0, 0.15)
        tone = int(max(0, min(255, v + rng.gauss(0, 13))))
        col = lut[tone]
        half = slen * rng.uniform(0.6, 1.45)
        dx, dy = math.cos(ang) * half, math.sin(ang) * half
        w = swid + rng.randrange(0, 2)
        d.line((x - dx, y - dy, x + dx, y + dy), fill=col, width=w)
        # A thinner, lighter pass along the same axis, offset toward the light.
        # Two flat lines a pixel apart read as a raised ridge of paint, which is
        # far cheaper than building a height field and lighting it.
        if rng.random() < 0.5:
            hi = lut[min(255, tone + 26)]
            d.line((x - dx - 1, y - dy - 2, x + dx - 1, y + dy - 2),
                   fill=hi, width=max(1, w // 2))
    return canvas


def impasto_field(colors, rng_seed=1993):
    """The full-canvas painted background, cached on the palette it was made from."""
    lut = ramp_lut(colors)
    tw, th = W // 2, H // 2
    key = {
        # Written as lists, not tuples: the key is compared against its own
        # JSON round-trip, and json has no tuple — a tuple here never matches
        # what comes back, so the field would be repainted on every switch.
        "stops": [list(lut[0]), list(lut[128]), list(lut[255])],
        "tile": [tw, th],
        "seed": rng_seed,
        "src": [ART_SOURCE.stat().st_mtime_ns, ART_SOURCE.stat().st_size]
        if ART_SOURCE.exists() else None,
        "v": 4,
    }
    if IMPASTO_PNG.exists() and IMPASTO_KEY.exists():
        try:
            if json.loads(IMPASTO_KEY.read_text()) == key:
                return Image.open(IMPASTO_PNG).convert("RGB")
        except (OSError, json.JSONDecodeError):
            pass

    print("  painting impasto field (first run for this palette)...",
          file=sys.stderr)
    rng = random.Random(rng_seed)
    tile = impasto_tile(tw, th, lut, rng)

    # Offset the tiling by half a tile so one *whole* tile lands dead centre —
    # the subject stays intact and the seams fall on the quarter lines, which is
    # how the reference desktop reads.
    img = Image.new("RGB", (W, H), lut[200])
    ox, oy = W // 2 - tw // 2, H // 2 - th // 2
    for ty in (-1, 0, 1):
        for tx in (-1, 0, 1):
            img.paste(tile, (ox + tx * tw, oy + ty * th))
    seam = ImageDraw.Draw(img)
    for tx in (-1, 0, 1, 2):
        seam.line((ox + tx * tw, 0, ox + tx * tw, H), fill=lut[70], width=2)
    for ty in (-1, 0, 1, 2):
        seam.line((0, oy + ty * th, W, oy + ty * th), fill=lut[70], width=2)

    IMPASTO_PNG.parent.mkdir(parents=True, exist_ok=True)
    tmp = IMPASTO_PNG.with_suffix(".tmp.png")
    img.save(tmp)
    os.replace(tmp, IMPASTO_PNG)
    IMPASTO_KEY.write_text(json.dumps(key))
    return img


WALLPAPERS = HOME / ".local/share/rice/art/wallpapers"


def tiled_field(path, mode="tile", anchor=(0.5, 0.5)):
    """A supplied painting as the background layer.

    `tile` repeats the image so that one whole copy lands with its centre on
    `anchor` (screen fractions) and the seams fall between — the construction
    `impasto_field` uses, and what the reference desktop does. `fill` covers the
    canvas with a single copy, for images that are one scene rather than a
    repeatable panel.

    `anchor` exists because the windows sit in fixed places: centring the tile
    puts a painting's subject at 0.5, 0.5, which is exactly where this layout's
    fetch and activity windows meet — so the subject ends up entirely hidden.
    Moving the tile is how a specific painting is composed against the layout.
    """
    art = Image.open(path).convert("RGB")
    if mode == "fill":
        return ImageOps.fit(art, (W, H), Image.Resampling.LANCZOS)

    tw, th = W // 2, H // 2
    tile = ImageOps.fit(art, (tw, th), Image.Resampling.LANCZOS)
    img = Image.new("RGB", (W, H))
    ox = int(anchor[0] * W - tw / 2)
    oy = int(anchor[1] * H - th / 2)
    for ty in (-2, -1, 0, 1, 2):
        for tx in (-2, -1, 0, 1, 2):
            img.paste(tile, (ox + tx * tw, oy + ty * th))

    # The seam is drawn rather than left implicit: sampled from the image's own
    # darker tones so it reads as a join in the painting, not a UI gridline.
    dark = min(tile.resize((16, 16)).getdata(), key=lambda c: sum(c))
    seam = ImageDraw.Draw(img)
    for tx in (-2, -1, 0, 1, 2, 3):
        seam.line((ox + tx * tw, 0, ox + tx * tw, H), fill=dark, width=2)
    for ty in (-2, -1, 0, 1, 2, 3):
        seam.line((0, oy + ty * th, W, oy + ty * th), fill=dark, width=2)
    return img


def field_entries(manifest):
    """The wallpapers this theme cycles through, with sane defaults."""
    entries = manifest.get("poster", {}).get("fields")
    if not entries:
        entries = [{"name": "impasto", "source": "impasto", "mode": "tile"}]
    return entries


def background_field(colors, spec):
    """Resolve a field spec to an image, falling back to the generated one."""
    if not spec or spec.get("source") in (None, "", "impasto"):
        return impasto_field(colors)
    src = Path(spec["source"]).expanduser()
    if not src.is_absolute():
        src = WALLPAPERS / src
    if not src.exists():
        print(f"note: wallpaper {src} is missing — using the generated field",
              file=sys.stderr)
        return impasto_field(colors)
    try:
        anchor = spec.get("anchor") or (0.5, 0.5)
        return tiled_field(src, spec.get("mode", "tile"), tuple(anchor))
    except OSError as e:
        print(f"note: {src.name} could not be read ({e}) — using the "
              f"generated field", file=sys.stderr)
        return impasto_field(colors)


def sys7_colors(colors):
    """The paper-and-ink palette the System 7 windows are drawn in."""
    return {
        "paper": hex_rgb(role(colors, "surface_container_lowest", "#f2efe2")),
        "shade": hex_rgb(role(colors, "surface_container_high", "#d9c6ac")),
        "ink": hex_rgb(colors.get("on_surface", "#201b13")),
        "muted": hex_rgb(colors.get("on_surface_variant", "#504535")),
        "line": hex_rgb(colors.get("outline", "#827663")),
        "rule": hex_rgb(colors.get("outline_variant", "#d4c5b0")),
        "accent": hex_rgb(colors.get("tertiary", "#4e6543")),
    }


# The window controls are drawn from whatever glyphs the mono font actually
# has. A missing codepoint still renders — as .notdef, the hollow tofu box — and
# still reports a nonzero width, so presence can't be tested by measuring. What
# distinguishes it is the bitmap itself: render a codepoint nothing could
# define and compare against it.
_NOTDEF = {}


def _glyph_bits(font, ch):
    # getmask() hands back a raw ImagingCore with no tobytes(), so the glyph is
    # rendered into an ordinary image and compared there instead.
    side = int(font.size * 3)
    im = Image.new("L", (side, side), 0)
    ImageDraw.Draw(im).text((font.size // 2, font.size // 2), ch, font=font,
                            fill=255)
    return im.tobytes()


def has_glyph(font, ch):
    key = (getattr(font, "path", None), font.size)
    if key not in _NOTDEF:
        # Plane 16 is private use; a text font has no reason to define it, so
        # whatever it renders is this font's .notdef box.
        _NOTDEF[key] = _glyph_bits(font, "\U0010fffd")
    try:
        return _glyph_bits(font, ch) != _NOTDEF[key]
    except Exception:
        return False


def controls_for(font):
    def pick(*candidates):
        return next((c for c in candidates if has_glyph(font, c)), candidates[-1])
    return f"{pick('∨', 'v')} {pick('∧', '^')} {pick('✕', '⨯', '×', 'x')}"


def sys7_window(draw, box, p, lined=0):
    """A System 7 program window: hard shadow, 2px frame, controls top-right."""
    x0, y0, x1, y1 = box
    draw.rectangle((x0 + 5, y0 + 5, x1 + 5, y1 + 5), fill=p["ink"])
    draw.rectangle(box, fill=p["paper"])
    draw.rectangle(box, outline=p["ink"], width=2)
    f = mono(24)
    ctl = controls_for(f)
    draw.text((x1 - 22 - draw.textlength(ctl, font=f), y0 + 12), ctl,
              font=f, fill=p["ink"])
    draw.line((x0 + 2, y0 + 42, x1 - 2, y0 + 42), fill=p["line"], width=2)
    if lined:
        y = y0 + lined
        while y < y1 - 6:
            draw.line((x0 + 3, y, x1 - 3, y), fill=p["rule"], width=2)
            y += lined


def draw_fetch(draw, box, p, colors):
    """The reference's `>fetch` window: a prompt, a small mascot, key/value rows."""
    sys7_window(draw, box, p)
    x0, y0, x1, y1 = box
    f = mono(26)
    small = mono(23)
    left = x0 + 26
    draw.text((left, y0 + 46), ">fetch", font=f, fill=p["ink"])

    mascot = ["      <3", "  (\\ /)    (\\ (\\", "  ( . .)   ( . .)",
              " c(*)(*)  (*)(*)o"]
    my = y0 + 92
    for line in mascot:
        draw.text((left + 14, my), line, font=small, fill=p["muted"])
        my += 28

    data = system_snapshot()
    rows = [("os", "linux-gnu"), ("font", "deserted"),
            ("trm", "kitty"), ("wm", data.get("session", "gnome"))]
    ry = y0 + 96
    key_x = x0 + (x1 - x0) * 0.52
    for key, value in rows:
        draw.text((key_x - draw.textlength(key + ":", font=small), ry),
                  key + ":", font=small, fill=p["muted"])
        draw.text((key_x + 14, ry), str(value), font=small, fill=p["ink"])
        ry += 30

    # The palette itself, shown as the swatch strip the reference prints.
    draw.text((key_x - draw.textlength("cols:", font=small), ry), "cols:",
              font=small, fill=p["muted"])
    swatches = [colors.get(k) for k in
                ("rice_red", "rice_yellow", "rice_green", "tertiary",
                 "primary", "secondary", "outline", "on_surface")]
    sx = key_x + 14
    sw = max(10, int((x1 - 26 - sx) / len(swatches)))
    for s in swatches:
        if not s:
            continue
        draw.rectangle((sx, ry + 2, sx + sw - 2, ry + 24), fill=hex_rgb(s))
        sx += sw

    draw.text((left, y1 - 92), f">{datetime.now():%Y}", font=small, fill=p["ink"])
    draw.text((left, y1 - 60), f"{datetime.now():%a %d %b %Y}".lower(),
              font=small, fill=p["muted"])
    draw.text((left, y1 - 30), ">", font=small, fill=p["ink"])


def draw_calendar(draw, box, p, day=None):
    sys7_window(draw, box, p)
    x0, y0, x1, y1 = box
    day = day or datetime.now()
    title = mono(28)
    cell = mono(24)
    head = f"{day:%B %Y}"
    draw.text(((x0 + x1) / 2 - draw.textlength(head, font=title) / 2, y0 + 44),
              head, font=title, fill=p["ink"])

    cal = calendar.Calendar(firstweekday=6)     # Sunday-first, like the reference
    names = ["Su", "Mo", "Tu", "We", "Th", "Fr", "Sa"]
    grid_w = (x1 - x0) - 56
    step = grid_w / 7
    gx, gy = x0 + 28, y0 + 84
    for i, n in enumerate(names):
        draw.text((gx + i * step, gy), n, font=cell, fill=p["muted"])
    gy += 32
    for week in cal.monthdayscalendar(day.year, day.month):
        for i, dnum in enumerate(week):
            if not dnum:
                continue
            s = str(dnum)
            tx = gx + i * step + (step - draw.textlength(s, font=cell)) / 2
            if dnum == day.day:
                draw.rectangle((tx - 6, gy - 3,
                                tx + draw.textlength(s, font=cell) + 6, gy + 27),
                               fill=p["ink"])
                draw.text((tx, gy), s, font=cell, fill=p["paper"])
            else:
                draw.text((tx, gy), s, font=cell, fill=p["ink"])
        gy += 30
        if gy > y1 - 30:
            break


def draw_threads(draw, snap, box, p):
    """Recent activity as a scroll of timestamped entries on ruled paper."""
    sys7_window(draw, box, p, lined=34)
    x0, y0, x1, y1 = box
    f = mono(22)
    small = mono(20)
    left = x0 + 24
    y = y0 + 48
    width = int((x1 - x0 - 56) / 11.5)

    entries = []
    for repo, edits in snap.get("repos", [])[:3]:
        entries.append((Path(repo).name if repo else "unknown",
                        f"{int(edits)} edits recorded against this tree today"))
    for app, seconds in snap.get("apps", [])[:4]:
        entries.append((str(app).lower(),
                        f"focused {R.fmt_duration(seconds).lower()}"))
    if not entries:
        entries = [("idle", "no activity recorded for this day")]

    now = datetime.now()
    for n, (name, body) in enumerate(entries):
        if y > y1 - 90:
            break
        draw.text((left, y), "[ ] Anonymous", font=f, fill=p["ink"])
        y += 30
        stamp = f"{now:%m/%d/%y}({now:%a})%02d:%02d:%02d No.%d" % (
            (n * 3 + 3) % 24, (n * 17) % 60, (n * 29) % 60, 109399000 + n * 431)
        draw.text((left, y), stamp, font=small, fill=p["muted"])
        y += 34
        for line in textwrap.wrap(f">>{name} — {body}", width=width)[:4]:
            if y > y1 - 60:
                break
            draw.text((left + 18, y), line, font=f, fill=p["accent"])
            y += 30
        y += 22

    draw.text((left, y1 - 38), f"{snap['date']}  ·  local only",
              font=small, fill=p["muted"])


def draw_todo_sys7(draw, items, box, p):
    sys7_window(draw, box, p, lined=34)
    x0, y0, x1, y1 = box
    f = mono(24)
    small = mono(20)
    draw.text((x0 + 24, y0 + 46), "todo", font=f, fill=p["ink"])
    y = y0 + 88
    rows = todo_rows(items)
    shown = 0
    if not rows:
        draw.text((x0 + 24, y), "nothing pending", font=f, fill=p["muted"])
    for lines in rows:
        row_h = max(46, len(lines) * 30 + 16)
        if y + row_h > y1 - 52:
            break
        draw.text((x0 + 24, y), "[ ]", font=small, fill=p["line"])
        for j, line in enumerate(lines):
            draw.text((x0 + 76, y - 2 + j * 30), line, font=f, fill=p["ink"])
        y += row_h
        shown += 1
    draw.text((x0 + 24, y1 - 36), f"{shown} shown / {len(rows)} open",
              font=small, fill=p["muted"])


def draw_focus_sys7(draw, snap, box, p):
    """The 24h plot, on a small paper plate.

    This was originally drawn straight onto the paint, which read well against
    the generated impasto field — that one is light everywhere by construction.
    Once the background became any supplied painting the assumption broke: on
    the coast image this lands on dark water and disappears. It keeps the plate
    minimal — no title bar, no controls — so it still reads as the quietest
    element rather than becoming another window.
    """
    x0, y0, x1, y1 = box
    label = mono(22)
    graph = mono(40)
    pad = 18
    draw.rectangle((x0 - pad, y0 - pad, x1 + pad, y0 + 128), fill=p["paper"])
    draw.rectangle((x0 - pad, y0 - pad, x1 + pad, y0 + 128),
                   outline=p["ink"], width=2)
    draw.text((x0, y0), "focus/24h", font=label, fill=p["ink"])
    draw.text((x0, y0 + 36), compact_focus(snap["hourly"]), font=graph,
              fill=p["ink"])
    draw.text((x0, y0 + 96), f"{R.fmt_duration(snap['total_secs']).lower()} focused",
              font=label, fill=p["muted"])


def render_deserted(snap, colors, field=None):
    img = background_field(colors, field)
    draw = ImageDraw.Draw(img)
    p = sys7_colors(colors)
    layout = load_layout(DESERTED_LAYOUT)

    draw_calendar(draw, component_box(layout, "calendar"), p)
    draw_fetch(draw, component_box(layout, "fetch"), p, colors)
    draw_threads(draw, snap, component_box(layout, "threads"), p)
    todos = R.load_todos()
    draw_todo_sys7(draw, todos, todo_box(layout, todos), p)
    draw_focus_sys7(draw, snap, component_box(layout, "focus"), p)
    return img


def render_collage(snap, colors):
    palette = root_colors(colors)
    img = Image.new("RGB", (W, H), palette["root"])
    draw = ImageDraw.Draw(img)
    layout = load_layout()

    # Artwork lives on the root plane. Programs paint over it where they land.
    paste_ink(img, ART_MAIN, component_box(layout, "main_art"), palette["muted"],
              contain=False, opacity=235)
    draw_system(draw, component_box(layout, "system"), palette)
    draw_preview(img, draw, component_box(layout, "preview"), palette)
    draw_recent(draw, snap, component_box(layout, "recent"), palette)
    todos = R.load_todos()
    draw_todo(draw, todos, todo_box(layout, todos), palette)
    draw_focus(draw, snap, component_box(layout, "focus"), palette)

    # One quiet root label supplies provenance without turning a repo into a brand.
    f = mono(18)
    root_mark = f"root:{datetime.now().strftime('%j')}  {snap['date']}"
    draw.text((M, H - 72), root_mark, font=f, fill=palette["dim"])
    return img


# ---------------------------------------------------------------------- main

def active_manifest():
    """The currently applied theme's manifest, or {} if there isn't one."""
    try:
        name = (HOME / ".local/share/rice/current-theme").read_text().strip()
        path = HOME / f".local/share/rice/themes/{name}/theme.json"
        return json.loads(path.read_text())
    except (OSError, json.JSONDecodeError):
        return {}


def active_style(manifest):
    """The composition the currently applied theme asks for.

    `rice-poster.timer` runs a bare `poster --apply` every hour and `todo`
    repaints with a bare `poster`, so without this the wallpaper would revert
    to the collage within the hour of switching themes, and on the next task
    edit. The theme is the source of truth; an explicit --style still wins.
    """
    style = manifest.get("poster", {}).get("style")
    return style if style in ("collage", "legacy", "deserted") else "collage"


def active_field(manifest, override=None):
    """The background the theme is currently cycled to (see the `wall` command)."""
    entries = field_entries(manifest)
    want = override or manifest.get("poster", {}).get("field")
    for e in entries:
        if e.get("name") == want:
            return e
    return entries[0]


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--seed", help="hex color to build the palette from")
    ap.add_argument("--drift", type=float, default=0.0, metavar="DEG",
                    help="rotate the seed hue by this many degrees (use with "
                         "--apply for a desktop that slowly changes over days)")
    ap.add_argument("--date", help="YYYY-MM-DD; defaults to today")
    ap.add_argument("--name", default="TODO", help="masthead word")
    ap.add_argument("--ascii", default=str(ASCII),
                    help="path to the ascii-art text drawn in the upper-left")
    ap.add_argument("--layout", choices=("collage", "legacy", "deserted"),
                    default=None, help=argparse.SUPPRESS)   # old name for --style
    ap.add_argument("--style", choices=("collage", "legacy", "deserted"),
                    default=None,
                    help="wallpaper composition (default: whatever the active "
                         "theme uses, else collage)")
    ap.add_argument("--field", metavar="NAME",
                    help="background to paint under the deserted composition, "
                         "by name from the theme's list (see `wall`)")
    ap.add_argument("--out", default=str(OUT))
    ap.add_argument("--apply", action="store_true",
                    help="set as wallpaper and retheme the desktop to match")
    ap.add_argument("--set", action="store_true", dest="set_only",
                    help="set the rendered image as the wallpaper without "
                         "rebuilding the palette (used by `theme`, which has "
                         "already applied one)")
    ap.add_argument("--tint", type=float, default=None,
                    help="tint passed through to retheme (default: value in state.json)")
    ap.add_argument("--scheme", default=None,
                    help="matugen scheme passed through to retheme "
                         "(default: value in state.json)")
    ap.add_argument("--preview", action="store_true")
    args = ap.parse_args()
    manifest = active_manifest()
    # --layout was the original spelling and poster.toml/docs still use it.
    args.style = args.layout or args.style or active_style(manifest)

    day = datetime.strptime(args.date, "%Y-%m-%d") if args.date else None
    snap = R.snapshot(day)
    if not snap["available"]:
        print("note: timeline database unreadable — rendering with empty data",
              file=sys.stderr)

    state_file = HOME / ".local/share/rice/state.json"
    state = {}
    if state_file.exists():
        try:
            state = json.loads(state_file.read_text())
        except json.JSONDecodeError:
            state = {}
    seed = args.seed or state.get("colors", {}).get("source") or "#040480"
    if args.drift:
        seed = shift_hue(seed, args.drift)

    # Honor the scheme/tint recorded by the last retheme so the hourly poster
    # run reproduces the applied palette instead of forcing tonal-spot/0.6.
    scheme = args.scheme or state.get("scheme", "tonal-spot")
    tint = args.tint if args.tint is not None else state.get("tint", 0.6)
    # Mode and paper must ride along too. Without them the hourly run re-derives
    # a *dark, uncompressed* palette from the same seed, which silently undoes a
    # light theme an hour after it was applied.
    mode = state.get("mode", "dark")
    paper = state.get("paper", 0.0)
    palette_args = ["--scheme", scheme, "--tint", str(tint),
                    "--mode", mode, "--paper", str(paper)]

    # Build the poster from the palette that *will* be applied, so the wallpaper
    # and the desktop chrome are generated from one seed rather than one being
    # re-derived from the other's pixels.
    colors = R.palette()
    if args.apply or args.seed or args.drift:
        res = subprocess.run(
            ["retheme", "--seed", seed] + palette_args + ["--no-wallpaper"],
            capture_output=True, text=True)
        if res.returncode != 0:
            print(res.stderr, file=sys.stderr)
            sys.exit("retheme failed while preparing the palette")
        colors = R.palette()

    if args.style == "legacy":
        img = render_legacy(snap, colors, name=args.name, ascii_path=args.ascii)
    elif args.style == "deserted":
        img = render_deserted(snap, colors, active_field(manifest, args.field))
    else:
        img = render_collage(snap, colors)
    out = Path(args.out).expanduser()
    out.parent.mkdir(parents=True, exist_ok=True)
    tmp = out.with_name(f"{out.stem}.tmp{out.suffix}")
    img.save(tmp)
    os.replace(tmp, out)
    todos = R.load_todos()
    open_n = sum(1 for t in todos if not t.get("done"))
    print(f"poster -> {out}  [{args.style} / {open_n}/{len(todos)} open / "
          f"{snap['date']} / seed {seed}]")

    if args.preview:
        prev = img.copy()
        prev.thumbnail((1100, 1100))
        p = Path("/tmp") / "poster-preview.png"
        prev.save(p)
        print(f"preview -> {p}")

    if args.set_only:
        # The palette is already applied; only the background needs pointing at
        # the new file. Never blank picture-uri first — the shell resolves an
        # empty URI against the cwd and the failure aborts the repaint.
        uri = out.resolve().as_uri()
        for key in ("picture-uri", "picture-uri-dark"):
            subprocess.run(["gsettings", "set", "org.gnome.desktop.background",
                            key, uri], check=False)
        subprocess.run(["gsettings", "set", "org.gnome.desktop.background",
                        "picture-options", "zoom"], check=False)
        print(f"  wallpaper -> {out.name}")

    if args.apply:
        subprocess.run(["retheme", "--seed", seed] + palette_args +
                       ["--wallpaper", str(out)], check=False)


if __name__ == "__main__":
    main()

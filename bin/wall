#!/usr/bin/env python3
"""wall — cycle the painting behind the current theme's composition.

    wall              # next background, and repaint
    wall prev         # previous one
    wall <name>       # pick one by name
    wall list         # show what this theme cycles through

The wallpaper is not replaced, only its background layer: the live utilities
the theme draws over it — fetch, calendar, activity, tasks, focus — stay put.
That is the point of the rice, so swapping to a bare image would lose it.

The choice is stored in the active theme's own manifest, so each theme
remembers what it was cycled to and `theme <name>` restores it.
"""
import argparse
import json
import subprocess
import sys
from pathlib import Path

HOME = Path.home()
RICE = HOME / ".local/share/rice"
CURRENT = RICE / "current-theme"


def active_name():
    if not CURRENT.exists():
        sys.exit("no active theme — run `theme <name>` first")
    return CURRENT.read_text().strip()


def manifest_path(name):
    p = RICE / "themes" / name / "theme.json"
    if not p.exists():
        sys.exit(f"active theme '{name}' has no manifest at {p}")
    return p


def load():
    name = active_name()
    path = manifest_path(name)
    return name, path, json.loads(path.read_text())


def fields(m):
    entries = m.get("poster", {}).get("fields")
    if not entries:
        sys.exit("this theme has no wallpapers to cycle through — only the "
                 "`deserted` style uses a background field")
    return entries


def repaint(name):
    """Re-render and set the wallpaper.

    Only the background layer changed, but the composition is drawn in one
    pass, so this is a normal full render — a couple of seconds at most, and
    the painted field is cached.
    """
    res = subprocess.run(["poster", "--set"])
    if res.returncode != 0:
        sys.exit("poster failed — wallpaper unchanged")


def save(path, m, choice):
    m.setdefault("poster", {})["field"] = choice
    path.write_text(json.dumps(m, indent=2) + "\n")


def main():
    ap = argparse.ArgumentParser(prog="wall", add_help=True,
                                 description=__doc__.split("\n")[0])
    ap.add_argument("target", nargs="?",
                    help="'next' (default), 'prev', 'list', or a wallpaper name")
    args = ap.parse_args()

    name, path, m = load()
    entries = fields(m)
    names = [e["name"] for e in entries]
    current = m.get("poster", {}).get("field") or names[0]
    if current not in names:
        current = names[0]
    i = names.index(current)

    target = args.target or "next"

    if target == "list":
        for n, e in zip(names, entries):
            src = e.get("source", "impasto")
            src = "generated impasto field" if src == "impasto" else src
            print(f"{'*' if n == current else ' '} {n:<12} {e.get('mode', 'tile'):<5} {src}")
        return

    if target == "next":
        choice = names[(i + 1) % len(names)]
    elif target == "prev":
        choice = names[(i - 1) % len(names)]
    elif target in names:
        choice = target
    else:
        sys.exit(f"no wallpaper named '{target}' in theme '{name}'\n"
                 f"have: {', '.join(names)}")

    save(path, m, choice)
    print(f"{name}: {current} -> {choice}")
    repaint(name)


if __name__ == "__main__":
    main()

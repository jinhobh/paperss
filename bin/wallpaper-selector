#!/usr/bin/env sh
# Launch the compiled Paperss selector. The wrapper keeps the existing command
# and ~/rice/bin/wallpaper-selector binding stable while the binary lives in a
# user-local build directory.
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
BINARY=${PAPERSS_SELECTOR_BIN:-"$HOME/.local/libexec/paperss/wallpaper-selector"}

if [ ! -x "$BINARY" ] && [ -x "$SCRIPT_DIR/../build/wallpaper-selector" ]; then
    BINARY="$SCRIPT_DIR/../build/wallpaper-selector"
fi

if [ ! -x "$BINARY" ]; then
    printf '%s\n' "Paperss selector binary is not installed: $BINARY" >&2
    printf '%s\n' "Run ./install.sh after installing GTK4 development packages." >&2
    exit 1
fi

exec "$BINARY" "$@"

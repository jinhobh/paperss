#!/usr/bin/env python3
"""rice-polish — apply the desktop chrome settings that aren't palette-derived.

    rice-polish            # show what would change
    rice-polish --apply    # apply it, recording the previous values first
    rice-polish --revert   # put everything back exactly as it was

Every write is recorded to ~/.local/share/rice/polish-backup.json before it
happens, so --revert restores the literal previous value rather than a guess
at what the default used to be.
"""
import argparse
import json
import math
import subprocess
import sys
from pathlib import Path

BACKUP = Path.home() / ".local/share/rice/polish-backup.json"
EXT = Path.home() / ".local/share/gnome-shell/extensions"
BLUR_SCHEMA = EXT / "blur-my-shell@aunetx/schemas"
JP_SCHEMA = EXT / "just-perfection-desktop@just-perfection/schemas"

# (schema_dir_or_None, schema, key, value, why)
SETTINGS = [
    (None, "org.gnome.desktop.interface", "gtk-theme", "Adwaita-dark",
     "WhiteSur hardcodes a macOS palette that overrides the generated gtk.css; "
     "Adwaita-dark defers to it"),
    (None, "org.gnome.desktop.interface", "icon-theme", "Delight 2",
     "user-chosen SVG icon set; inherits Cosmic/Adwaita for missing icons"),
    (None, "org.gnome.desktop.interface", "monospace-font-name",
     "FiraCode Nerd Font 11",
     "matches the terminal and the poster's caption face"),
    (None, "org.gnome.desktop.interface", "font-hinting", "slight",
     "sharper stems at small sizes without distorting the letterforms"),
    (None, "org.gnome.desktop.interface", "font-antialiasing", "rgba",
     "subpixel rendering on an LCD panel"),

    # Panel blur was enabled with sigma 0, which is a no-op — the panel was
    # only being made transparent, never actually blurred.
    (BLUR_SCHEMA, "org.gnome.shell.extensions.blur-my-shell.panel", "sigma", "24",
     "panel blur was enabled but sigma was 0, so nothing was blurring"),
    (BLUR_SCHEMA, "org.gnome.shell.extensions.blur-my-shell.panel", "brightness",
     "0.7", "keeps panel text readable over a dark wallpaper"),
    (BLUR_SCHEMA, "org.gnome.shell.extensions.blur-my-shell.panel", "static-blur",
     "true", "cheaper and steadier than re-blurring every frame"),
    (BLUR_SCHEMA, "org.gnome.shell.extensions.blur-my-shell.panel", "blur", "false",
     "the bottom micro-panel should merge directly with the root window"),
    # Dock blur is intentionally OFF. Over the near-solid dark-indigo wallpaper
    # it revealed nothing, and the two ways to round it both failed here:
    # dynamic blur can't round corners without the native gi://Blur lib (not
    # installed on this system), and static blur left a hard seam on the left
    # edge. The dock fill is a translucent CSS panel on .dash-background in the
    # Rice shell theme instead — rounded, borderless, and seam-free.
    (BLUR_SCHEMA, "org.gnome.shell.extensions.blur-my-shell.dash-to-dock", "blur",
     "false", "blur is invisible over the solid wallpaper; a CSS tint is used"),
    (BLUR_SCHEMA, "org.gnome.shell.extensions.blur-my-shell.overview", "sigma", "32",
     "slightly deeper blur so overview thumbnails separate from the wallpaper"),

    # A very small bottom panel provides the live pieces the generated wallpaper
    # cannot: workspace state, focus status, clock, and quick settings.
    (JP_SCHEMA, "org.gnome.shell.extensions.just-perfection", "panel", "true",
     "keeps the live micro-panel available"),
    (JP_SCHEMA, "org.gnome.shell.extensions.just-perfection", "panel-in-overview",
     "false", "the overview already has its own navigation"),
    (JP_SCHEMA, "org.gnome.shell.extensions.just-perfection", "top-panel-position",
     "1", "moves the shell panel to the bottom edge like the reference desktop"),
    (JP_SCHEMA, "org.gnome.shell.extensions.just-perfection", "panel-size", "20",
     "reduces the panel to a quiet one-line status strip"),
    (JP_SCHEMA, "org.gnome.shell.extensions.just-perfection",
     "panel-button-padding-size", "1", "removes pill-like button padding"),
    (JP_SCHEMA, "org.gnome.shell.extensions.just-perfection",
     "panel-indicator-padding-size", "1", "keeps tiny status items compact"),
    (JP_SCHEMA, "org.gnome.shell.extensions.just-perfection", "panel-icon-size", "14",
     "matches the compact bitmap-like text"),
    (JP_SCHEMA, "org.gnome.shell.extensions.just-perfection", "clock-menu-position", "1",
     "places the live clock at the bottom-right"),
    (JP_SCHEMA, "org.gnome.shell.extensions.just-perfection",
     "clock-menu-position-offset", "0", "keeps the clock at the edge of its group"),
    (JP_SCHEMA, "org.gnome.shell.extensions.just-perfection", "activities-button", "false",
     "Super already opens Overview; the label is unnecessary chrome"),
    (JP_SCHEMA, "org.gnome.shell.extensions.just-perfection",
     "panel-notification-icon", "false", "removes a decorative status dot"),
    (JP_SCHEMA, "org.gnome.shell.extensions.just-perfection", "keyboard-layout", "false",
     "the current single layout does not need a permanent indicator"),
    (JP_SCHEMA, "org.gnome.shell.extensions.just-perfection", "accessibility-menu", "false",
     "the settings remain available without a permanent icon"),
    (JP_SCHEMA, "org.gnome.shell.extensions.just-perfection", "power-icon", "false",
     "power actions remain inside quick settings"),
    (JP_SCHEMA, "org.gnome.shell.extensions.just-perfection",
     "workspace-background-corner-size", "1", "squares the Overview workspace"),

    # Ubuntu Dock remains reachable on demand but disappears from the root
    # composition and loses the rounded translucent pill.
    (None, "org.gnome.shell.extensions.dash-to-dock", "dock-fixed", "false",
     "keeps the dock off the idle desktop"),
    (None, "org.gnome.shell.extensions.dash-to-dock", "autohide", "true",
     "reveals the dock only at the screen edge"),
    (None, "org.gnome.shell.extensions.dash-to-dock", "intellihide", "true",
     "prevents the dock covering working windows"),
    (None, "org.gnome.shell.extensions.dash-to-dock", "dash-max-icon-size", "28",
     "turns the fallback dock into a compact utility strip"),
    (None, "org.gnome.shell.extensions.dash-to-dock", "background-opacity", "0.0",
     "removes the dock pill fill"),
    (None, "org.gnome.shell.extensions.dash-to-dock", "force-straight-corner", "true",
     "removes the remaining rounded dock silhouette"),
    (None, "org.gnome.shell.extensions.dash-to-dock", "custom-theme-shrink", "true",
     "keeps the autohide dock tightly wrapped"),
    (None, "org.gnome.shell.extensions.dash-to-dock", "show-trash", "false",
     "the root collage should not carry desktop metaphors"),
    (None, "org.gnome.shell.extensions.dash-to-dock", "show-mounts", "false",
     "mounts remain available in Files"),
    (None, "org.gnome.shell.extensions.dash-to-dock", "show-show-apps-button", "false",
     "Super twice still opens the application grid"),

    (JP_SCHEMA, "org.gnome.shell.extensions.just-perfection", "animation", "3",
     "quicker transitions; the default reads as sluggish next to the blur"),
]


def same_number(a, b):
    """True if two gsettings values are the same number.

    gsettings round-trips doubles through their binary form, so writing 0.7
    reads back as 0.69999999999999996. Compared as strings that never matches,
    and the setting is reported as pending on every run.
    """
    try:
        return math.isclose(float(a), float(b), rel_tol=1e-9)
    except (TypeError, ValueError):
        return False


def gs(args, schemadir=None):
    cmd = ["gsettings"]
    if schemadir:
        cmd += ["--schemadir", str(schemadir)]
    return subprocess.run(cmd + args, capture_output=True, text=True)


def get(schemadir, schema, key):
    r = gs(["get", schema, key], schemadir)
    return r.stdout.strip() if r.returncode == 0 else None


def set_(schemadir, schema, key, value):
    return gs(["set", schema, key, value], schemadir).returncode == 0


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--apply", action="store_true")
    ap.add_argument("--revert", action="store_true")
    args = ap.parse_args()

    if args.revert:
        if not BACKUP.exists():
            sys.exit("nothing to revert — no backup recorded")
        saved = json.loads(BACKUP.read_text())
        for entry in saved:
            d = Path(entry["schemadir"]) if entry["schemadir"] else None
            if entry["old"] is None:
                continue
            ok = set_(d, entry["schema"], entry["key"], entry["old"])
            print(f"{'ok  ' if ok else 'FAIL'} {entry['key']} -> {entry['old']}")
        print("\nreverted. Wallpaper and palette are untouched by this script.")
        return

    backup, changes = [], []
    for schemadir, schema, key, value, why in SETTINGS:
        old = get(schemadir, schema, key)
        if old is None:
            print(f"skip  {schema}.{key} — schema not available")
            continue
        norm_old = old.strip("'")
        if norm_old == value or old == value or same_number(norm_old, value):
            continue
        changes.append((schemadir, schema, key, value, old, why))
        backup.append({"schemadir": str(schemadir) if schemadir else None,
                       "schema": schema, "key": key, "old": old})

    if not changes:
        print("nothing to change — chrome already polished")
        return

    for _, schema, key, value, old, why in changes:
        print(f"  {key}\n      {old}  ->  {value}\n      {why}")

    if not args.apply:
        print(f"\n{len(changes)} change(s). Re-run with --apply to write them.")
        return

    BACKUP.parent.mkdir(parents=True, exist_ok=True)
    # Record before writing, so a crash mid-apply still leaves a usable revert.
    BACKUP.write_text(json.dumps(backup, indent=2))

    for schemadir, schema, key, value, _old, _why in changes:
        ok = set_(schemadir, schema, key, value)
        print(f"{'ok  ' if ok else 'FAIL'} {key} -> {value}")
    print(f"\napplied. `rice-polish --revert` restores the previous values "
          f"(saved to {BACKUP}).")


if __name__ == "__main__":
    main()
